<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Experiencia de RA</title>
    <!-- Cargamos la librería oficial estable de Google para Realidad Aumentada -->
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.4.0/model-viewer.min.js"></script>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #2c3e50; }
        model-viewer { width: 100%; height: 100%; display: block; }
    </style>
</head>
<body>

    <!-- REEMPLAZA "lineup.glb" POR EL NOMBRE EXACTO DE TU ARCHIVO ABAJO -->
    <model-viewer 
        src="objeto.glb" 
        ar 
        ar-modes="webxr scene-viewer quick-look" 
        camera-controls 
        touch-action="pan-y"
        shadow-intensity="1" 
        alt="Un modelo 3D en Realidad Aumentada">
    </model-viewer>

</body>
</html>

