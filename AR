<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Experiencia de RA</title>
    <!-- Cargamos el motor de Realidad Aumentada de Google -->
    <script type="module" src="https://googleapis.com"></script>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #f0f0f0; }
        model-viewer { width: 100%; height: 100%; }
    </style>
</head>
<body>

    <!-- REEMPLAZA "objeto.glb" POR EL NOMBRE EXACTO DE TU ARCHIVO 3D -->
    <model-viewer 
        src="lineup.glb" 
        ar 
        ar-modes="webxr scene-viewer quick-look" 
        camera-controls 
        touch-action="pan-y"
        shadow-intensity="1" 
        alt="Un modelo 3D en Realidad Aumentada">
    </model-viewer>

</body>
</html>
